<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="com.android.settings">

    <application>

        <activity android:name="Settings$LumineSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.android.settings"
            android:parentActivityName="Settings" />

       <!-- Extensions -->
        <activity-alias android:name="Settings$ExtensionsActivity"
             android:label="@string/extensions_title"
             android:icon="@drawable/ic_extensions"
             android:exported="true"
             android:targetActivity="Settings$LumineSettingsActivity"
             android:taskAffinity="com.android.settings"
             android:parentActivityName="Settings">
             <intent-filter>
                 <action android:name="com.android.settings.action.SETTINGS" />
                 <category android:name="android.intent.category.DEFAULT" />
             </intent-filter>
             <meta-data android:name="com.android.settings.FRAGMENT_CLASS"
                 android:value="org.luminedroid.extensions.Extensions" />
             <meta-data android:name="com.android.settings.title"
                        android:resource="@string/extensions_title" />
             <meta-data android:name="com.android.settings.summary"
                        android:resource="@string/extensions_summary"/>
             <meta-data android:name="com.android.settings.PRIMARY_PROFILE_CONTROLLED"
                        android:value="true" />
         </activity-alias>

         <activity-alias
             android:name="Settings$ExtensionsStatusbarActivity"
             android:targetActivity="com.android.settings.SubSettings"
             android:label="@string/extensions_statusbar_title"
             android:icon="@drawable/extensions_homepage_statusbar"
             android:exported="true">
             <meta-data
                 android:name="com.android.settings.FRAGMENT_CLASS"
                 android:value="org.luminedroid.extensions.category.statusbar.StatusBarSettings" />
         </activity-alias>

         <activity-alias
             android:name="Settings$ExtensionsQuickSettingsActivity"
             android:targetActivity="com.android.settings.SubSettings"
             android:label="@string/extensions_quicksettings_title"
             android:icon="@drawable/extensions_homepage_quicksettings"
             android:exported="true">
             <meta-data
                 android:name="com.android.settings.FRAGMENT_CLASS"
                 android:value="org.luminedroid.extensions.category.qs.QuickSettings" />
         </activity-alias>

         <activity-alias
             android:name="Settings$ExtensionsButtonActivity"
             android:targetActivity="com.android.settings.SubSettings"
             android:label="@string/extensions_button_title"
             android:icon="@drawable/extensions_homepage_button"
             android:exported="true">
             <meta-data
                 android:name="com.android.settings.FRAGMENT_CLASS"
                 android:value="org.luminedroid.extensions.category.button.ButtonSettings" />
         </activity-alias>

         <activity-alias
             android:name="Settings$ExtensionsLockScreenActivity"
             android:targetActivity="com.android.settings.SubSettings"
             android:label="@string/extensions_lockscreen_title"
             android:icon="@drawable/extensions_homepage_lockscreen"
             android:exported="true">
             <meta-data
                 android:name="com.android.settings.FRAGMENT_CLASS"
                 android:value="org.luminedroid.extensions.category.lockscreen.LockScreenSettings" />
         </activity-alias>

         <activity-alias
             android:name="Settings$ExtensionsMiscActivity"
             android:targetActivity="com.android.settings.SubSettings"
             android:label="@string/extensions_misc_title"
             android:icon="@drawable/extensions_homepage_misc"
             android:exported="true">
             <meta-data
                 android:name="com.android.settings.FRAGMENT_CLASS"
                 android:value="org.luminedroid.extensions.category.misc.MiscSettings" />
         </activity-alias>

         <activity-alias
             android:name="Settings$ExtensionsAboutActivity"
             android:targetActivity="com.android.settings.SubSettings"
             android:label="@string/extensions_about_title"
             android:icon="@drawable/extensions_homepage_about"
             android:exported="true">
             <meta-data
                 android:name="com.android.settings.FRAGMENT_CLASS"
                 android:value="org.luminedroid.extensions.category.about.AboutLumineDroidFragment" />
         </activity-alias>

        <activity-alias
            android:name=".display.RefreshRateSettings"
            android:label="@string/refresh_rate_title"
            android:exported="true"
            android:targetActivity="Settings$LumineSettingsActivity">
            <intent-filter android:priority="32">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.android.settings.SHORTCUT" />
            </intent-filter>
            <intent-filter android:priority="1">
                <action android:name="android.settings.REFRESH_RATE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="com.android.settings.FRAGMENT_CLASS"
                android:value="com.android.settings.display.RefreshRateSettings" />
            <meta-data android:name="com.android.settings.HIGHLIGHT_MENU_KEY"
                       android:value="@string/menu_key_display"/>
            <meta-data android:name="com.android.settings.PRIMARY_PROFILE_CONTROLLED"
                android:value="true" />
        </activity-alias>

    </application>

</manifest>
