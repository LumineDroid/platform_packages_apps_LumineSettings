  Outer ring drawn as a radial gradient oval — mimics the
  "absolute -inset-3 bg-gradient-to-br from-pink-500 to-blue-500 rounded-full"
  glow from the web MemberCard.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="50%"
        android:startColor="@color/luminedroid_avatar_ring"
        android:endColor="#00000000" />
</shape>
