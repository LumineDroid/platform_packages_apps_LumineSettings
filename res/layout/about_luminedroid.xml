<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="32dp"
                android:paddingBottom="24dp"
                android:background="@drawable/luminedroid_header_card">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:background="@drawable/luminedroid_hero_glow" />

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_luminedroid_logo" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/luminedroid_project_name"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:gravity="center"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/luminedroid_project_tagline"
                    android:textSize="13sp"
                    android:textColor="@color/luminedroid_accent_pink"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/luminedroid_project_desc"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.55"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/luminedroid_version_value"
                    android:textSize="11sp"
                    android:textColor="@color/luminedroid_version_text"
                    android:background="@drawable/luminedroid_version_bg"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp"
                    android:layout_marginBottom="20dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/luminedroid_divider_center"
                    android:layout_marginBottom="18dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:id="@+id/btn_social_github"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/luminedroid_btn_bg"
                        android:focusable="true"
                        android:clickable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_luminedroid_github"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/luminedroid_social_github"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:textColor="@color/luminedroid_badge_pink_text" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_social_telegram"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/luminedroid_btn_bg"
                        android:focusable="true"
                        android:clickable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_luminedroid_telegram"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/luminedroid_social_telegram"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:textColor="@color/luminedroid_badge_pink_text" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_social_website"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:background="@drawable/luminedroid_btn_bg"
                        android:focusable="true"
                        android:clickable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_luminedroid_website"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/luminedroid_social_website"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:textColor="@color/luminedroid_badge_pink_text" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/luminedroid_meet_the_team"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/luminedroid_text_page_title"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/luminedroid_page_subtitle"
                android:textSize="13sp"
                android:textColor="@color/luminedroid_text_page_subtitle"
                android:lineSpacingMultiplier="1.5"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/tab_devs"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/luminedroid_tab_selector"
                android:focusable="true"
                android:clickable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_luminedroid_code"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/luminedroid_tab_devs"
                    android:textSize="13sp"
                    android:textColor="@color/luminedroid_tab_text_selector" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_contribs"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:background="@drawable/luminedroid_tab_selector"
                android:focusable="true"
                android:clickable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_luminedroid_users"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/luminedroid_tab_contribs"
                    android:textSize="13sp"
                    android:textColor="@color/luminedroid_tab_text_selector" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_luminedroid_section"
                android:tint="@color/luminedroid_accent_pink"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/section_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/luminedroid_text_section_title" />

            <TextView
                android:id="@+id/section_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/luminedroid_pill_text"
                android:background="@drawable/luminedroid_pill_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/team_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingBottom="32dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
