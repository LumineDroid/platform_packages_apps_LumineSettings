<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.luminedroid.utils.WallpaperView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.45"
                android:background="@color/extensions_header_bg"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/extensions_title"
                    android:textColor="@color/extensions_text_color"
                    android:fontFamily="@*android:string/config_headlineFontFamily"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="marquee"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/extensions_homepage_summary"
                    android:textColor="@color/extensions_text_color"
                    android:textSize="13sp"
                    android:alpha="0.8"
                    android:maxLines="3"
                    android:gravity="center"
                    android:textAlignment="center"/>

            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <!-- Statusbar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/extensions_statusbar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="start"
                android:padding="16dp"
                android:background="@drawable/extensions_homepage_bg">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="10dp"
                    android:src="@drawable/ic_statusbar"
                    android:background="@drawable/adaptive_icon_shape"
                    android:backgroundTint="?android:colorAccent"
                    android:tint="?android:colorPrimary"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/extensions_statusbar_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extensions_statusbar_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:fontFamily="@*android:string/config_headlineFontFamily"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/extensions_statusbar_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/extensions_statusbar_summary"
                    android:textSize="12sp"
                    android:alpha="0.65"
                    android:maxLines="3"
                    android:textColor="?android:attr/textColorSecondary"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Settings -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/extensions_quicksettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="start"
                android:padding="16dp"
                android:background="@drawable/extensions_homepage_bg">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="10dp"
                    android:src="@drawable/ic_quicksettings"
                    android:background="@drawable/adaptive_icon_shape"
                    android:backgroundTint="?android:colorAccent"
                    android:tint="?android:colorPrimary"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/extensions_quicksettings_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extensions_quicksettings_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:fontFamily="@*android:string/config_headlineFontFamily"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/extensions_quicksettings_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/extensions_quicksettings_summary"
                    android:textSize="12sp"
                    android:alpha="0.65"
                    android:maxLines="3"
                    android:textColor="?android:attr/textColorSecondary"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical">

            <!-- Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/extensions_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start"
                    android:padding="16dp"
                    android:background="@drawable/extensions_homepage_bg">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="10dp"
                        android:src="@drawable/ic_button"
                        android:background="@drawable/adaptive_icon_shape"
                        android:backgroundTint="?android:colorAccent"
                        android:tint="?android:colorPrimary"
                        android:padding="8dp"/>

                    <TextView
                        android:id="@+id/extensions_button_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/extensions_button_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:fontFamily="@*android:string/config_headlineFontFamily"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/extensions_button_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/extensions_button_summary"
                        android:textSize="12sp"
                        android:alpha="0.65"
                        android:maxLines="3"
                        android:textColor="?android:attr/textColorSecondary"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lockscreen -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/extensions_lockscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start"
                    android:padding="16dp"
                    android:background="@drawable/extensions_homepage_bg">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="10dp"
                        android:src="@drawable/ic_lockscreen"
                        android:background="@drawable/adaptive_icon_shape"
                        android:backgroundTint="?android:colorAccent"
                        android:tint="?android:colorPrimary"
                        android:padding="8dp"/>

                    <TextView
                        android:id="@+id/extensions_lockscreen_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/extensions_lockscreen_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:fontFamily="@*android:string/config_headlineFontFamily"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/extensions_lockscreen_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/extensions_lockscreen_summary"
                        android:textSize="12sp"
                        android:alpha="0.65"
                        android:maxLines="3"
                        android:textColor="?android:attr/textColorSecondary"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/extensions_about"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/extensions_homepage_bg">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/ic_about"
                    android:background="@drawable/adaptive_icon_shape"
                    android:backgroundTint="?android:colorAccent"
                    android:tint="?android:colorPrimary"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/extensions_about_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extensions_about_title"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:fontFamily="@*android:string/config_headlineFontFamily"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/extensions_about_summary"
                    android:textSize="12sp"
                    android:alpha="0.65"
                    android:maxLines="5"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="?android:attr/textColorSecondary"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/extensions_misc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/extensions_homepage_bg">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <TextView
                    android:id="@+id/extensions_misc_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/extensions_misc_title"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:fontFamily="@*android:string/config_headlineFontFamily"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/extensions_misc_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/extensions_misc_summary"
                    android:textSize="12sp"
                    android:alpha="0.65"
                    android:maxLines="2"
                    android:textColor="?android:attr/textColorSecondary"/>

            </LinearLayout>

            <ImageView
                android:id="@+id/extensions_misc_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_misc"
                android:background="@drawable/adaptive_icon_shape"
                android:backgroundTint="?android:colorAccent"
                android:tint="?android:colorPrimary"
                android:scaleType="center"
                android:padding="8dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
