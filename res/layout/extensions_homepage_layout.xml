<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/extensions_statusbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/extensions_homepage_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <androidx.preference.internal.PreferenceImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="16dp"
                android:padding="8dp"
                android:src="@drawable/extensions_homepage_statusbar"/>

            <TextView
                android:id="@+id/extensions_statusbar_title"
                android:text="@string/extensions_statusbar_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily"/>

            <TextView
                android:id="@+id/extensions_statusbar_summary"
                android:layout_marginTop="4dp"
                android:maxLines="3"
                android:alpha="0.7"
                android:text="@string/extensions_statusbar_summary"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/extensions_quicksettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/extensions_homepage_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <androidx.preference.internal.PreferenceImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="16dp"
                android:padding="8dp"
                android:src="@drawable/extensions_homepage_quicksettings"/>

            <TextView
                android:id="@+id/extensions_quicksettings_title"
                android:text="@string/extensions_quicksettings_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily"/>

            <TextView
                android:id="@+id/extensions_quicksettings_summary"
                android:layout_marginTop="4dp"
                android:maxLines="3"
                android:alpha="0.7"
                android:text="@string/extensions_quicksettings_summary"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/extensions_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/extensions_homepage_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">

                <androidx.preference.internal.PreferenceImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="16dp"
                    android:padding="8dp"
                    android:src="@drawable/extensions_homepage_button"/>

                <TextView
                    android:id="@+id/extensions_button_title"
                    android:text="@string/extensions_button_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"/>

                <TextView
                    android:id="@+id/extensions_button_summary"
                    android:layout_marginTop="4dp"
                    android:maxLines="3"
                    android:alpha="0.7"
                    android:text="@string/extensions_button_summary"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/extensions_lockscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/extensions_homepage_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">

                <androidx.preference.internal.PreferenceImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="16dp"
                    android:padding="8dp"
                    android:src="@drawable/extensions_homepage_lockscreen"/>

                <TextView
                    android:id="@+id/extensions_lockscreen_title"
                    android:text="@string/extensions_lockscreen_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"/>

                <TextView
                    android:id="@+id/extensions_lockscreen_summary"
                    android:layout_marginTop="4dp"
                    android:maxLines="3"
                    android:alpha="0.7"
                    android:text="@string/extensions_lockscreen_summary"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/extensions_about"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/extensions_homepage_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/extensions_homepage_about"/>

            <TextView
                android:id="@+id/extensions_about_title"
                android:layout_marginTop="12dp"
                android:text="@string/extensions_about_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily"/>

            <TextView
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:text="@string/extensions_about_summary"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/extensions_misc"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/extensions_homepage_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/extensions_misc_title"
                android:text="@string/extensions_misc_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily"/>

            <TextView
                android:id="@+id/extensions_misc_summary"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:alpha="0.7"
                android:text="@string/extensions_misc_summary"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>

        <androidx.preference.internal.PreferenceImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/extensions_homepage_misc"/>
    </LinearLayout>

</LinearLayout>
