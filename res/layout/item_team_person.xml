<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="@drawable/luminedroid_card_ripple"
    android:background="@drawable/luminedroid_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:gravity="center_horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/luminedroid_avatar_ring" />

            <ImageView
                android:id="@+id/person_avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:background="@drawable/luminedroid_avatar_bg"
                android:src="@drawable/ic_luminedroid_person"
                android:contentDescription="@string/luminedroid_avatar_desc" />
        </FrameLayout>

        <TextView
            android:id="@+id/person_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/luminedroid_text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/person_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/luminedroid_text_role"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/person_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="@color/luminedroid_text_handle"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/luminedroid_divider_gradient"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/btn_github"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:padding="9dp"
                android:src="@drawable/ic_luminedroid_github"
                android:background="@drawable/luminedroid_btn_bg"
                android:contentDescription="@string/luminedroid_github_desc"
                android:focusable="true"
                android:clickable="true"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/btn_telegram"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="9dp"
                android:src="@drawable/ic_luminedroid_telegram"
                android:background="@drawable/luminedroid_btn_bg"
                android:contentDescription="@string/luminedroid_telegram_desc"
                android:focusable="true"
                android:clickable="true"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <TextView
            android:id="@+id/person_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="9sp"
            android:textAllCaps="true"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>
</FrameLayout>

