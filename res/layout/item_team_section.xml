<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingTop="24dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_luminedroid_section"
            android:tint="@color/luminedroid_accent_pink"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/luminedroid_text_section_title" />
    </LinearLayout>

    <TextView
        android:id="@+id/section_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28dp"
        android:textSize="12sp"
        android:textColor="@color/luminedroid_text_section_subtitle" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/luminedroid_divider_gradient"
        android:layout_marginTop="10dp" />

</LinearLayout>
