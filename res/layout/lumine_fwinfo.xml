<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingVertical="8dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/lumine_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/lumine_fwinfo_header_bg"
        android:orientation="horizontal">

        <androidx.preference.internal.PreferenceImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="center"
            android:src="@drawable/lumine_header_logo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/lumine_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:text="@string/lumine_brand"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/m3_sys_color_dynamic_light_on_tertiary_container"
                android:fontFamily="@*android:string/config_headlineFontFamily"/>

            <TextView
                android:id="@+id/lumine_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAlignment="center"
                android:singleLine="true"
                android:alpha="0.7"
                android:textSize="12sp"
                android:textColor="@color/m3_sys_color_dynamic_light_on_tertiary_container"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Android version + Security patch -->
    <LinearLayout
        android:id="@+id/lumine_fwinfo_mid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:background="@drawable/lumine_fwinfo_mid_bg">

        <!-- Android Version -->
        <LinearLayout
            android:id="@+id/lumine_android_version"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true">

            <androidx.preference.internal.PreferenceImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:scaleType="center"
                android:src="@drawable/lumine_android_icon" />

            <TextView
                android:id="@+id/lumine_android_version_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/lumine_android_version_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily"/>

            <TextView
                android:id="@+id/lumine_android_version_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>

        <!-- Security Patch -->
        <LinearLayout
            android:id="@+id/lumine_security_patch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true">

            <androidx.preference.internal.PreferenceImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:scaleType="center"
                android:src="@drawable/lumine_secpatch_icon" />

            <TextView
                android:id="@+id/lumine_security_patch_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="@string/lumine_secpatch_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily"/>

            <TextView
                android:id="@+id/lumine_security_patch_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Device info (Baseband, Kernel, Build Date, Build Number) -->
    <LinearLayout
        android:id="@+id/lumine_fwinfo_bot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/lumine_fwinfo_bot_bg"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp">

        <!-- Baseband -->
        <LinearLayout
            android:id="@+id/lumine_baseband"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/lumine_baseband_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@string/lumine_baseband_version_title"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily"/>

            <TextView
                android:id="@+id/lumine_baseband_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.7"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>

        <!-- Kernel -->
        <LinearLayout
            android:id="@+id/lumine_kernel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:clickable="true">

            <TextView
                android:id="@+id/lumine_kernel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@string/lumine_kernel_version_title"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily"/>

            <TextView
                android:id="@+id/lumine_kernel_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.7"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>

        <!-- Build Date -->
        <LinearLayout
            android:id="@+id/lumine_build_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/lumine_build_date_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@string/lumine_build_date_title"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily"/>

            <TextView
                android:id="@+id/lumine_build_date_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.7"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>

        <!-- Build Number -->
        <LinearLayout
            android:id="@+id/lumine_build_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/lumine_build_number_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@string/lumine_build_number_title"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily"/>

            <TextView
                android:id="@+id/lumine_build_number_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.7"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>
    </LinearLayout>
    <org.luminedroid.utils.LumineDroidFirmwareVersionView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>
</LinearLayout>
