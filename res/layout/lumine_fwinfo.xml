<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="12dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/lumine_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/lumine_fwinfo_header_bg"
        android:paddingVertical="12dp"
        android:paddingHorizontal="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.preference.internal.PreferenceImageView
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:scaleType="centerCrop"
            android:src="@drawable/lumine_header_logo"
            android:contentDescription="@string/lumine_brand" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/lumine_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lumine_brand"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/m3_sys_color_dynamic_light_on_tertiary_container"
                android:fontFamily="@*android:string/config_headlineFontFamily"
                android:ellipsize="marquee"
                android:maxLines="1"
                android:gravity="center" />

            <TextView
                android:id="@+id/lumine_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:textSize="14sp"
                android:textColor="@color/m3_sys_color_dynamic_light_on_tertiary_container"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lumine_fwinfo_mid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/lumine_fwinfo_mid_bg"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/lumine_android_version"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            android:paddingHorizontal="10dp"
            android:gravity="center"
            android:clickable="true">

            <androidx.preference.internal.PreferenceImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:scaleType="centerInside"
                android:src="@drawable/lumine_android_icon" />

            <TextView
                android:id="@+id/lumine_android_version_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/firmware_version"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily" />

            <TextView
                android:id="@+id/lumine_android_version_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.75"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lumine_maintainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            android:paddingHorizontal="10dp"
            android:gravity="center"
            android:clickable="true">

            <androidx.preference.internal.PreferenceImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:scaleType="centerInside"
                android:src="@drawable/lumine_maintainer_icon" />

            <TextView
                android:id="@+id/lumine_maintainer_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/lumine_maintainer"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@*android:string/config_headlineFontFamily" />

            <TextView
                android:id="@+id/lumine_maintainer_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.75"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/lumine_fwinfo_card_list" />

    <org.luminedroid.utils.LumineDroidFirmwareVersionView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
