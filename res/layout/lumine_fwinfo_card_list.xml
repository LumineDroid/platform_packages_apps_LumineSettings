<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginHorizontal="16dp"
    android:orientation="vertical">

    <!-- Security Patch -->
    <LinearLayout
        android:id="@+id/lumine_security_patch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:background="@drawable/lumine_card_bg_top"
        android:gravity="center_vertical"
        android:minHeight="?android:listPreferredItemHeightSmall"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:orientation="vertical"
        android:clickable="true">

        <TextView
            android:id="@+id/lumine_security_patch_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/security_patch"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:fontFamily="@*android:string/config_headlineFontFamily"/>

        <TextView
            android:id="@+id/lumine_security_patch_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:maxLines="3"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>

    <!-- Baseband -->
    <LinearLayout
        android:id="@+id/lumine_baseband"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:background="@drawable/lumine_card_bg_mid"
        android:gravity="center_vertical"
        android:minHeight="?android:listPreferredItemHeightSmall"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lumine_baseband_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/baseband_version"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:fontFamily="@*android:string/config_headlineFontFamily"/>

        <TextView
            android:id="@+id/lumine_baseband_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:maxLines="3"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>

    <!-- Kernel -->
    <LinearLayout
        android:id="@+id/lumine_kernel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:background="@drawable/lumine_card_bg_mid"
        android:gravity="center_vertical"
        android:minHeight="?android:listPreferredItemHeightSmall"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:orientation="vertical"
        android:clickable="true">

        <TextView
            android:id="@+id/lumine_kernel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kernel_version"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:fontFamily="@*android:string/config_headlineFontFamily"/>

        <TextView
            android:id="@+id/lumine_kernel_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:maxLines="3"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>

    <!-- Build Date -->
    <LinearLayout
        android:id="@+id/lumine_build_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:background="@drawable/lumine_card_bg_mid"
        android:gravity="center_vertical"
        android:minHeight="?android:listPreferredItemHeightSmall"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lumine_build_date_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@*lineageos.platform:string/build_date"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:fontFamily="@*android:string/config_headlineFontFamily"/>

        <TextView
            android:id="@+id/lumine_build_date_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:maxLines="3"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>

    <!-- Build Number -->
    <LinearLayout
        android:id="@+id/lumine_build_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/lumine_card_bg_bot"
        android:gravity="center_vertical"
        android:minHeight="?android:listPreferredItemHeightSmall"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lumine_build_number_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/build_number"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:fontFamily="@*android:string/config_headlineFontFamily"/>

        <TextView
            android:id="@+id/lumine_build_number_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:maxLines="3"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>

</LinearLayout>
